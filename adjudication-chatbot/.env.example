# Copy to .env and fill in. Never commit the real .env.

FLASK_ENV=production
FLASK_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- This chatbot's identity ---
DEPT_CODE=ADJUDICATION
CHATBOT_SOURCE=adjudication-chatbot
DEPT_DISPLAY_NAME=Adjudication

# --- MySQL 8.x (health_ai_platform) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=adjudication_chatbot_app
MYSQL_PASSWORD=localroot
MYSQL_DB=health_ai_platform
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT=5

# --- Keycloak 26 Central Realm (PKCE public client) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/health-ai-central
KEYCLOAK_CLIENT_ID=adjudication-chatbot-pkce
# Leave the three below blank to derive from KEYCLOAK_ISSUER
KEYCLOAK_AUTHORIZATION_ENDPOINT=
KEYCLOAK_TOKEN_ENDPOINT=
KEYCLOAK_LOGOUT_ENDPOINT=
KEYCLOAK_JWKS_URL=
# Optional: local JWKS file instead of a live fetch (offline/dev/test)
KEYCLOAK_JWKS_STATIC_FILE=
KEYCLOAK_SCOPES=openid profile email
KEYCLOAK_DEPARTMENT_CLAIM=department
KEYCLOAK_LEEWAY_SECONDS=10
OAUTH_REDIRECT_URI=http://localhost:5007/auth/callback
OAUTH_STATE_MAX_AGE_SECONDS=300
POST_LOGOUT_REDIRECT_URI=http://localhost:5007/

# DEV ONLY — leave false everywhere except a local dev box.
DEV_BYPASS_AUTH=false

# --- Central LLM Gateway ---
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_TIMEOUT_SECONDS=35

# --- Logging ---
LOG_DIR=./logs
LOG_FILE_NAME=adjudication_chatbot.log
LOG_MAX_BYTES=26214400
LOG_BACKUP_COUNT=10
LOG_LEVEL=INFO

# --- Retrieval tuning ---
MAX_ADJUDICATION_ROWS=25
MAX_KNOWLEDGE_DOCS=5
MAX_CONVERSATION_HISTORY_TURNS=6
