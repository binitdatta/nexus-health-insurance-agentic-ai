# Copy to .env and fill in. Never commit the real .env.

FLASK_ENV=production
FLASK_DEBUG=false

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_PRIMARY_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1500
ANTHROPIC_TIMEOUT_SECONDS=30

# --- MySQL 8.x (health_ai_platform) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=localroot
MYSQL_DB=health_ai_platform
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT=5

# --- Keycloak 26 Central Realm ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/health-ai-central
# Leave blank to derive as {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
# Optional: point at a local JWKS json file instead of fetching over HTTP
# (offline/air-gapped deployments, or local dev/testing).
KEYCLOAK_JWKS_STATIC_FILE=
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600
KEYCLOAK_AUDIENCE=central-llm-api
KEYCLOAK_DEPARTMENT_CLAIM=department
KEYCLOAK_LEEWAY_SECONDS=10

# DEV ONLY — leave false everywhere except a local dev box.
DEV_BYPASS_AUTH=false

# --- Logging ---
LOG_DIR=./logs
LOG_FILE_NAME=llm_gateway.log
LOG_MAX_BYTES=26214400
LOG_BACKUP_COUNT=10
LOG_LEVEL=INFO
