# Copy to .env and adjust as needed. This app has no database and no
# auth of its own — it's a static informational hub, so there isn't
# much to configure.

FLASK_ENV=production
FLASK_DEBUG=false

# Not security-sensitive here (no sessions/cookies rely on it), but
# Flask requires SECRET_KEY to be set to something.
SECRET_KEY=change-me-if-you-care

# Hostname used to build the "Open chatbot" links (Chatbots dropdown,
# home page cards). Leave as localhost for local dev. If you deploy
# this hub somewhere the chatbots are also reachable at, e.g. a
# private DNS name, set that here instead.
HUB_HOST=localhost
